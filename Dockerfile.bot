# Time-Machine Chess — Lichess BOT account (one era per container).
#
# Separate from the website's Dockerfile: this one has no web server, no
# frontend, and only one era model resident, so it fits a small always-on
# instance (~1.2GB RSS in practice). Deploy as a second Railway service with
# railway.bot.json, or `docker run` it on any 2GB box.
#
#   docker build -f Dockerfile.bot -t tmc-bot .
#   docker run -e LICHESS_BOT_TOKEN=lip_xxx -e TMC_ERA=romantic tmc-bot
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl git \
    && rm -rf /var/lib/apt/lists/*

# The maintained bot framework: event streaming, challenge queueing, reconnects,
# abort/timeout rules. Pinned to a commit, not a tag — the project versions by
# date (2026.8.9.2) and its git tags stopped at 1.1.3 in 2019, which is a
# different, incompatible bot. An unpinned clone is a silent upgrade at 3am.
ARG LICHESS_BOT_REF=df7e730de58cc3ef2f1415a0dc2eeda842d39167
RUN git init /app/lichess-bot \
    && cd /app/lichess-bot \
    && git remote add origin https://github.com/lichess-bot-devs/lichess-bot.git \
    && git fetch --depth 1 origin ${LICHESS_BOT_REF} \
    && git checkout --detach FETCH_HEAD

# Dependencies. The CPU wheel index is the PRIMARY index, with PyPI as the
# fallback, and maia2 is resolved in the SAME pip invocation as torch. Both
# details matter: maia2 requires torch<2.9,>=2.8.0, so installing it in a
# later command makes pip re-resolve torch from PyPI - which means the CUDA
# build, which drags in ~2.5GB of nvidia_* wheels (cublas, cudnn, nccl...)
# and silently replaces the CPU torch installed a line earlier. This bot runs
# a policy network on a CPU box; not one byte of that is reachable.
RUN pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
    --extra-index-url https://pypi.org/simple \
    -r /app/lichess-bot/requirements.txt torch maia2

# Fail the BUILD, loudly, if CUDA wheels ever creep back in - the symptom
# otherwise is a multi-GB image that builds fine and then sits in "Creating
# containers" forever, which reads like a Railway problem rather than ours.
RUN if pip list --format=freeze | grep -qi '^nvidia-'; then \
      echo "ERROR: CUDA wheels leaked into the image - check the torch/maia2 resolution"; \
      pip list --format=freeze | grep -i '^nvidia-'; \
      exit 1; \
    fi; \
    python -c "import torch; print('torch', torch.__version__, '| cuda:', torch.version.cuda)"

# Our code. backend/ carries the engines and the shared move recipe; config/
# carries the era definitions (the source of truth for the era list).
COPY backend ./backend
COPY config ./config
COPY scripts/fetch_models.py ./scripts/fetch_models.py
COPY lichess_bot ./lichess_bot
RUN chmod +x /app/lichess_bot/start.sh

# Bake the pilot era's checkpoint so restarts are fast; start.sh fetches a
# different era on first boot if TMC_ERA says otherwise.
ARG WEIGHTS_BASE=https://github.com/nickjlamb/time-machine-chess/releases/download/weights-v1
ARG BAKED_ERA=romantic
RUN mkdir -p models maia2_models \
    && curl -fL -o models/${BAKED_ERA}.pt ${WEIGHTS_BASE}/${BAKED_ERA}.pt \
    && curl -fL -o maia2_models/rapid_model.pt ${WEIGHTS_BASE}/rapid_model.pt

ENV PYTHONPATH=/app \
    TMC_ROOT=/app \
    MAX_LOADED_MODELS=1 \
    TMC_ERA=romantic \
    PYTHONUNBUFFERED=1

CMD ["/app/lichess_bot/start.sh"]
